# 复制为 `packages/studio/.env`（或仓库根目录 `.env`），填入你自己的 Key。不要提交 `.env`。
# 也可在 Studio「设置 → LLM」里添加多套 base URL + API key + 模型，并做连通性测试。
# 在 ChatECNU 点左下角头像 → 我的令牌：https://chat.ecnu.edu.cn
# 模型文档：https://developer.ecnu.edu.cn/vitepress/llm/model.html

ECNU_API_KEY=
ECNU_API_BASE_URL=https://chat.ecnu.edu.cn/open/api/v1
ECNU_MODEL=ecnu-max
# Optional completion budget for streaming agent calls (default 8192)
ECNU_MAX_TOKENS=
